#!name=GitHub 星标推送时间
#!desc=在 GitHub App 星标列表语言后显示推送时间
#!author=TomCatXue

# homepage: https://github.com/TomCatXue/MyCookieCenter
# 原插件: https://github.com/TomCatXue/MyCookieCenter/blob/main/loon/GitHubPushTime.plugin
# 移植为 Surge 模块自用
# icon: https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/icons/github.png
# tag: GitHub,星标,推送时间

[Script]
# 请求增强：给 StarredRepositoriesForUser 查询补充 pushedAt/updatedAt
GitHubPushTimeRequest = type=http-request, pattern=^https?://api\.github\.com/graphql, requires-body=true, timeout=10, script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/github_push_time/github_push_time.js?v=20260818-12

# 响应注入：在星标列表语言后显示推送时间
GitHubPushTimeResponse = type=http-response, pattern=^https?://api\.github\.com/graphql, requires-body=true, timeout=10, script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/github_push_time/github_push_time.js?v=20260818-12

[MITM]
hostname = %APPEND% api.github.com
