#!name=NodeSeek & DeepFlood 签到
#!desc=抓取 Cookie + 定时签到。打开两站「个人名片」页捕获 Token（成功会通知）；默认每天 09:00 签到。
#!category=Checkin
#!arguments=Cron:0 9 * * *,RandomChickenLeg:false
#!arguments-desc=Cron：签到定时（默认每天 09:00）\nRandomChickenLeg：false=固定 5 鸡腿，true=随机

[Script]
# NodeSeek - 捕获 Token
NodeSeekToken = type=http-response, pattern=^https:\/\/www\.nodeseek\.com\/api\/account\/getInfo\/.+\?readme=1&signature=1&phone=1, requires-body=true, timeout=60, script-path=https://raw.githubusercontent.com/StarYunLee/Profiles/main/Surge/Script/nodeseek.js

NodeSeekCheckin = type=cron, cronexp={{{Cron}}}, timeout=60, wake-system=1, script-path=https://raw.githubusercontent.com/StarYunLee/Profiles/main/Surge/Script/nodeseek.js, argument={{{RandomChickenLeg}}}

# DeepFlood - 捕获 Token
DeepFloodToken = type=http-response, pattern=^https:\/\/www\.deepflood\.com\/api\/account\/getInfo\/(.+)phone=1, requires-body=true, timeout=60, script-path=https://raw.githubusercontent.com/StarYunLee/Profiles/main/Surge/Script/deepflood.js

DeepFloodCheckin = type=cron, cronexp={{{Cron}}}, timeout=60, wake-system=1, script-path=https://raw.githubusercontent.com/StarYunLee/Profiles/main/Surge/Script/deepflood.js, argument={{{RandomChickenLeg}}}

[MITM]
hostname = %APPEND% www.nodeseek.com, www.deepflood.com
